<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Select your board — SSC, CBSE, or ICSE — on EduStreamix." />
  <title>Select Board — EduStreamix</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800&family=Noto+Sans+Devanagari:wght@400;600&family=Noto+Sans+Telugu:wght@400;600&family=Noto+Sans+Tamil:wght@400;600&family=Noto+Sans+Kannada:wght@400;600&family=Noto+Sans+Malayalam:wght@400;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="step-body">

  <nav class="navbar scrolled" id="navbar">
    <a href="/" class="nav-brand">
      <span class="brand-icon">🎓</span>
      <span class="brand-text">EduStreami<span class="brand-x">x</span></span>
    </a>
    <div class="nav-links">
      <a href="/" class="nav-home-link">
        <span class="home-icon">🏠</span>
        <span class="home-text" data-i18n="Home">Home</span>
      </a>
      <div class="nav-lang-group">
        <span class="nav-lang-label" data-i18n="Choose your language">Choose your language</span>
        <select class="nav-lang-switcher" id="nav-lang-switcher">
          <option value="English">English</option>
          <option value="Hindi">हिंदी</option>
          <option value="Telugu">తెలుగు</option>
          <option value="Tamil">தமிழ்</option>
          <option value="Kannada">ಕನ್ನಡ</option>
          <option value="Malayalam">മലയാളം</option>
        </select>
      </div>
    </div>
  </nav>

  <main class="step-main">
    <div class="step-container">

      <div class="step-header">
        <h1 class="step-title"><span data-i18n="Select Your Board">Select Your Board</span></h1>
        <p class="step-subtitle bold-subtitle" data-i18n="Choose your Board to access study materials">Choose your Board to access study materials</p>
      </div>

      <div class="board-grid" id="board-grid">
        <div class="board-card" id="board-card-ssc" data-board="SSC">
          <div class="board-card-glow"></div>
          <div class="board-card-content">
            <span class="board-icon">🏫</span>
            <div class="board-card-info">
              <h3 class="board-card-title" data-i18n="SSC">SSC</h3>
              <p class="board-card-label" data-i18n="State Board">State Board</p>
            </div>
          </div>
          <div class="board-card-select">
            <input type="radio" name="board-selector" id="radio-ssc" value="SSC" class="card-radio">
          </div>
        </div>
        
        <div class="board-card" id="board-card-cbse" data-board="CBSE">
          <div class="board-card-glow"></div>
          <div class="board-card-content">
            <span class="board-icon">📘</span>
            <div class="board-card-info">
              <h3 class="board-card-title" data-i18n="CBSE">CBSE</h3>
              <p class="board-card-label" data-i18n="Central Board">Central Board</p>
            </div>
          </div>
          <div class="board-card-select">
            <input type="radio" name="board-selector" id="radio-cbse" value="CBSE" class="card-radio">
          </div>
        </div>
        
        <div class="board-card" id="board-card-icse" data-board="ICSE">
          <div class="board-card-glow"></div>
          <div class="board-card-content">
            <span class="board-icon">🎓</span>
            <div class="board-card-info">
              <h3 class="board-card-title" data-i18n="ICSE">ICSE</h3>
              <p class="board-card-label" data-i18n="Indian Certificate">Indian Certificate</p>
            </div>
          </div>
          <div class="board-card-select">
            <input type="radio" name="board-selector" id="radio-icse" value="ICSE" class="card-radio">
          </div>
        </div>
      </div>

    </div>
  </main>

  <footer class="footer">
    <div class="footer-inner">
      <span class="footer-brand">🎓 EduStreami<span class="brand-x">x</span></span>
      <span class="footer-copy">&copy; 2026 EduStreamix. Built for learners.</span>
    </div>
  </footer>

  <script src="/js/i18n.js"></script>
  <script src="/js/global-nav.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Restore selected board from localStorage
      const storedBoard = localStorage.getItem('selectedBoard');
      if (storedBoard) {
        const activeCard = document.getElementById(`board-card-${storedBoard.toLowerCase()}`);
        if (activeCard) {
          activeCard.classList.add('selected');
          const radio = activeCard.querySelector('.card-radio');
          if (radio) radio.checked = true;
        }
      }

      // Add click handlers on board cards
      document.querySelectorAll('.board-card').forEach(card => {
        card.addEventListener('click', (e) => {
          const board = card.getAttribute('data-board');
          localStorage.setItem('selectedBoard', board);

          // Update selection styling
          document.querySelectorAll('.board-card').forEach(c => c.classList.remove('selected'));
          card.classList.add('selected');

          // Check corresponding radio button
          const radio = card.querySelector('.card-radio');
          if (radio) radio.checked = true;

          // Notify global-nav.js to update the "Next" button
          if (window.updateGlobalNav) window.updateGlobalNav();
        });
      });

      const switcher = document.getElementById('nav-lang-switcher');
      if (switcher) {
        switcher.value = localStorage.getItem('appLang') || 'English';
        switcher.addEventListener('change', (e) => {
          const selectedLang = e.target.value;
          localStorage.setItem('appLang', selectedLang);
          if (window.applyLanguage) window.applyLanguage(selectedLang);
        });
      }
    });
  </script>
</body>
</html>
