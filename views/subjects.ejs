<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Browse subjects on EduStreamix and start learning." />
  <title>Subjects — EduStreamix</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800&family=Noto+Sans+Devanagari:wght@400;600&family=Noto+Sans+Telugu:wght@400;600&family=Noto+Sans+Tamil:wght@400;600&family=Noto+Sans+Kannada:wght@400;600&family=Noto+Sans+Malayalam:wght@400;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="step-body subjects-page">

  <nav class="navbar scrolled" id="navbar">
    <a href="/" class="nav-brand">
      <span class="brand-icon">🎓</span>
      <span class="brand-text">EduStreami<span class="brand-x">x</span></span>
    </a>
    <div class="nav-actions">
      <a href="/" class="nav-home-link">
        <span class="home-icon">🏠</span>
        <span class="home-text" data-i18n="Home">Home</span>
      </a>
      <div class="nav-lang-group">
        <select class="nav-lang-switcher" id="nav-lang-switcher">
          <option value="English">English</option>
          <option value="Hindi">हिंदी</option>
          <option value="Telugu">తెలుగు</option>
          <option value="Tamil">தமிழ்</option>
          <option value="Kannada">ಕನ್ನಡ</option>
          <option value="Malayalam">മലയാളം</option>
        </select>
      </div>
    </div>
  </nav>

  <main class="step-main">
    <div class="step-container">

      <div class="step-header">
        <div class="page-top-heading">
          <p class="top-heading-line">CLASS 8</p>
          <h1 class="page-main-title">Select Your <%= selectedBoard %> Subject</h1>
          <p class="page-subtitle font-lucida" style="font-weight: 700;" data-i18n="Pick a subject to explore chapters and start watching">Pick a subject to explore chapters and start watching</p>
        </div>
      </div>

      <div class="subjects-grid" id="subjects-grid">
        <!-- Filled by JS -->
      </div>

    </div>
  </main>

  <footer class="footer">
    <div class="footer-inner">
      <span class="footer-brand">🎓 EduStreami<span class="brand-x">x</span></span>
      <span class="footer-copy">&copy; 2026 EduStreamix. Built for learners.</span>
    </div>
  </footer>

  <script>
    (function () {
      'use strict';

      const GRADE = '<%= selectedGrade %>';
      const BOARD = '<%= selectedBoard %>';

      const SUBJECT_ICONS = {
        'Mathematics':'📐','Science':'🔬','Social Science':'🌍','English':'📖',
        'Hindi':'📝','Physics':'⚡','Chemistry':'🧪','Biology':'🧬',
        'General Science':'🔬','Social Studies':'🌍','Telugu':'📜',
        'Physical Science':'⚡','Biological Science':'🧬'
      };

      const grid = document.getElementById('subjects-grid');

      async function loadSubjects() {
        const appLang = localStorage.getItem('appLang') || 'English';
        grid.innerHTML = Array(5).fill('<div class="skeleton-card"></div>').join('');
        try {
          const res = await fetch('/api/subjects?grade=' + GRADE + '&board=' + BOARD + '&lang=' + appLang);
          const data = await res.json();

          if (!data.subjects || !data.subjects.length) {
            const msg = window.t ? window.t('No subjects found.') : 'No subjects found.';
            grid.innerHTML = '<p class="no-data-msg">' + msg + '</p>';
            return;
          }

          grid.innerHTML = '';
          const storedSubject = localStorage.getItem('selectedSubject');
          data.subjects.forEach((subjTranslated, i) => {
            const originalSubj = data.originalSubjects ? data.originalSubjects[i] : subjTranslated;
            const card = document.createElement('a');
            card.href = '#';
            card.className = 'subject-card';
            if (storedSubject === originalSubj) {
              card.classList.add('selected');
            }
            card.id = 'subject-' + originalSubj.toLowerCase().replace(/\s+/g, '-');
            card.innerHTML =
              '<span class="subject-icon">' + (SUBJECT_ICONS[originalSubj] || '📖') + '</span>' +
              '<span class="subject-name">' + subjTranslated + '</span>';
            
            // Save selection to localStorage on click & update state
            card.addEventListener('click', (e) => {
              e.preventDefault();
              localStorage.setItem('selectedSubject', originalSubj);
              
              // Clear previous selection and select current
              document.querySelectorAll('.subject-card').forEach(c => c.classList.remove('selected'));
              card.classList.add('selected');

              // Notify global nav to enable Next button
              if (window.updateGlobalNav) window.updateGlobalNav();

              const lang = new URLSearchParams(window.location.search).get('language') || localStorage.getItem('appLang') || 'English';
              setTimeout(() => {
                window.location.href = `/study?grade=${GRADE}&board=${BOARD}&subject=${encodeURIComponent(originalSubj)}&language=${encodeURIComponent(lang)}`;
              }, 140);
            });

            grid.appendChild(card);
          });
        } catch (e) {
          const msg = window.t ? window.t('Error loading subjects.') : 'Error loading subjects.';
          grid.innerHTML = '<p class="no-data-msg error-msg">' + msg + '</p>';
        }
      }

      // Make globally available so languageChanged can trigger reload
      window.loadSubjects = loadSubjects;

      // Initial load — wait for i18n to be ready so t() works
      document.addEventListener('languageChanged', () => {
        loadSubjects();
      });
      // Also load immediately in case i18nReady fires before DOMContentLoaded
      document.addEventListener('DOMContentLoaded', () => {
        if (window.i18nReady) loadSubjects();
      });
    })();
  </script>
  <script src="/js/i18n.js"></script>
  <script src="/js/global-nav.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const switcher = document.getElementById('nav-lang-switcher');
      if (switcher) {
        switcher.value = localStorage.getItem('appLang') || 'English';
        switcher.addEventListener('change', (e) => {
          const selectedLang = e.target.value;
          localStorage.setItem('appLang', selectedLang);
          if (window.applyLanguage) window.applyLanguage(selectedLang);
        });
      }
    });
  </script>
</body>
</html>
