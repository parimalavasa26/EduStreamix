<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Select your preferred language — EduStreamix." />
  <title>Select Language — EduStreamix</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800&family=Noto+Sans+Devanagari:wght@400;600&family=Noto+Sans+Telugu:wght@400;600&family=Noto+Sans+Tamil:wght@400;600&family=Noto+Sans+Kannada:wght@400;600&family=Noto+Sans+Malayalam:wght@400;600&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>

<body class="step-body">

  <nav class="navbar scrolled" id="navbar">
    <a href="/" class="nav-brand">
      <span class="brand-icon">🎓</span>
      <span class="brand-text">EduStreami<span class="brand-x">x</span></span>
    </a>
    <div class="nav-actions">
      <a href="/" class="nav-home-link">
        <span class="home-icon">🏠</span>
        <span class="home-text" data-i18n="Home">Home</span>
      </a>
      <div class="nav-lang-group">
        <select id="nav-lang-switcher" class="nav-lang-switcher">
          <option value="English">English</option>
          <option value="Hindi">हिंदी</option>
          <option value="Telugu">తెలుగు</option>
          <option value="Tamil">தமிழ்</option>
          <option value="Kannada">ಕನ್ನಡ</option>
          <option value="Malayalam">മലയാളം</option>
        </select>
      </div>
    </div>
  </nav>

  <main class="step-main">
    <div class="step-container">

      <!-- Progress indicator -->
      <div class="step-progress" id="step-progress">
        <div class="step-dot active" data-step="1">
          <span class="step-dot-inner">1</span>
          <span class="step-dot-label" data-i18n="Language">Language</span>
        </div>
        <div class="step-line"></div>
        <div class="step-dot" data-step="2">
          <span class="step-dot-inner">2</span>
          <span class="step-dot-label" data-i18n="Board">Board</span>
        </div>
        <div class="step-line"></div>
        <div class="step-dot" data-step="3">
          <span class="step-dot-inner">3</span>
          <span class="step-dot-label" data-i18n="Subjects">Subjects</span>
        </div>
      </div>

      <div class="step-header">
        <a href="/" class="back-step-link" id="back-to-home" data-i18n="Back to Home">← Back to Home</a>
        <h1 class="step-title"><span data-i18n="Select Language">Select Language</span></h1>
        <p class="step-subtitle" data-i18n="Choose your preferred language for your lessons">Choose your preferred language for your lessons</p>
      </div>

      <div class="board-grid" id="language-grid">
        <%
          const langs = [
            { key: 'English',   native: 'English',   flag: '🇬🇧' },
            { key: 'Hindi',     native: 'हिंदी',     flag: '🇮🇳' },
            { key: 'Telugu',    native: 'తెలుగు',    flag: '🇮🇳' },
            { key: 'Tamil',     native: 'தமிழ்',     flag: '🇮🇳' },
            { key: 'Kannada',   native: 'ಕನ್ನಡ',    flag: '🇮🇳' },
            { key: 'Malayalam', native: 'മലയാളം',  flag: '🇮🇳' }
          ];
        %>
        <% langs.forEach(lang => { %>
          <a href="#" class="board-card language-selector" id="lang-<%= lang.key.toLowerCase() %>" data-lang="<%= lang.key %>">
            <div class="board-card-glow"></div>
            <span class="board-icon"><%= lang.flag %></span>
            <h3 class="board-card-title"><%= lang.native %></h3>
            <p class="board-card-label"><%= lang.key %></p>
            <span class="board-card-arrow">→</span>
          </a>
        <% }) %>
      </div>

    </div>
  </main>

  <footer class="footer">
    <div class="footer-inner">
      <span class="footer-brand">🎓 EduStreami<span class="brand-x">x</span></span>
      <span class="footer-copy">&copy; 2026 EduStreamix. Built for learners.</span>
    </div>
  </footer>

  <script src="/js/i18n.js"></script>
  <script>
    function updateLanguageSelection() {
      const currentLang = localStorage.getItem('appLang') || 'English';
      document.querySelectorAll('.language-selector').forEach(el => {
        if (el.getAttribute('data-lang') === currentLang) {
          el.classList.add('selected');
        } else {
          el.classList.remove('selected');
        }
      });
      if (window.updateGlobalNav) window.updateGlobalNav();
    }

    document.querySelectorAll('.language-selector').forEach(el => {
      el.addEventListener('click', function (e) {
        e.preventDefault();
        const selectedLang = this.getAttribute('data-lang');
        localStorage.setItem('appLang', selectedLang);
        if (window.applyLanguage) applyLanguage(selectedLang);
        updateLanguageSelection();
      });
    });

    document.addEventListener('DOMContentLoaded', () => {
      const switcher = document.getElementById('nav-lang-switcher');
      if (switcher) {
        switcher.value = localStorage.getItem('appLang') || 'English';
        switcher.addEventListener('change', (e) => {
          const selectedLang = e.target.value;
          localStorage.setItem('appLang', selectedLang);
          if (window.applyLanguage) applyLanguage(selectedLang);
          updateLanguageSelection();
        });
      }
      updateLanguageSelection();
    });
  </script>
</body>

</html>
